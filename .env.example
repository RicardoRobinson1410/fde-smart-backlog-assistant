# ============================================================================
# FDE Smart Backlog Assistant - Environment Configuration (All Optional)
# ============================================================================
# If OPENAI_API_KEY is omitted, the engine automatically runs in deterministic
# Offline Reviewer Replay Mode so reviewers can test without billing keys.

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Scenario Configuration Path (swap to adapt to any domain/use case)
SCENARIO_CONFIG_PATH=config/scenario_config.json

# Optional Variable Overrides (override scenario_config.json values via env)
FDE_DOMAIN_NAME=
FDE_AGENT_ROLE=
FDE_ID_PREFIX=

# Optional GitHub Issues Integration (uses `gh` CLI or GITHUB_TOKEN)
GITHUB_REPO=RicardoRobinson1410/fde-smart-backlog-assistant
GITHUB_TOKEN=
