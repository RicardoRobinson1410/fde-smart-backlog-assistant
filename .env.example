# ============================================================================
# FDE Smart Backlog Assistant - Environment Configuration (All Optional)
# ============================================================================
# If OPENAI_API_KEY is omitted, the engine automatically runs in deterministic
# Offline Reviewer Replay Mode so reviewers can test without billing keys.
# OpenAI API Key Permissions (if using Restricted key instead of All):
#   - Model capabilities -> Write (/v1/chat/completions)
#   - Models -> Read (optional, for listing/verifying models)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Per-Subagent Model Routing (Cost Optimization: lightweight models for extraction/audit, stronger model only for security review)
OPENAI_EXTRACTOR_MODEL=gpt-4o-mini
OPENAI_AUDITOR_MODEL=gpt-4o-mini
OPENAI_SECURITY_MODEL=gpt-4o

# Scenario Configuration Path (swap to adapt to any domain/use case)
SCENARIO_CONFIG_PATH=config/scenario_config.json

# Optional Variable Overrides (override scenario_config.json values via env)
FDE_DOMAIN_NAME="Enterprise Cloud & FinTech Engineering"
FDE_AGENT_ROLE="Staff Forward Deployed Engineer (FDE) and Agile Technical Product Manager"
FDE_ID_PREFIX=STORY

# Optional GitHub Issues Integration (uses `gh` CLI or GITHUB_TOKEN / GITHUB_PAT)
# Fine-grained PAT (Recommended): Repository permissions -> Issues: Read & Write, Metadata: Read-only (plus Administration: Read & Write if creating new repos via setup script)
# Classic PAT: `repo` (or `public_repo` for public repos) + `workflow` (if pushing CI workflows)
GITHUB_REPO=RicardoRobinson1410/fde-smart-backlog-assistant
GITHUB_TOKEN=
